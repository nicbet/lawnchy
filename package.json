{
  "name": "lawnchy",
  "version": "0.1.0",
  "description": "Sit back, watch your repos, launch anything. A terminal dashboard for every git repository under a directory.",
  "license": "MIT",
  "author": "Nicolas Bettenburg",
  "homepage": "https://github.com/nicbet/lawnchy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicbet/lawnchy.git"
  },
  "bugs": {
    "url": "https://github.com/nicbet/lawnchy/issues"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "cli",
    "worktree",
    "lazygit",
    "opentui",
    "dashboard"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "lawnchy": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/react": "0.8.2",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
